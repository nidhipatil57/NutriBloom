generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  password       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  meals          Meal[]
  nutritionLogs  NutritionLog[]
  goals          Goal?
  preferences    UserPreference?
  plannedMeals   PlannedMeal[]
  groceryLists   GroceryList[]
  insights       Insight[]
  savedRecipes   SavedRecipe[]
  waterLogs      WaterLog[]
  moodLogs       MoodLog[]
  achievements   UserAchievement[]
  mealTemplates  MealTemplate[]
  bloomScores    BloomScore[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model Recipe {
  id             String   @id @default(cuid())
  spoonacularId  Int?     @unique
  title          String
  image          String?
  summary        String?
  instructions   String?
  servings       Int      @default(4)
  readyInMinutes Int      @default(30)
  cuisines       String   @default("[]")
  diets          String   @default("[]")
  tags           String   @default("[]")
  sourceUrl      String?
  calories       Float    @default(0)
  protein        Float    @default(0)
  carbs          Float    @default(0)
  fat            Float    @default(0)
  fiber          Float    @default(0)
  sugar          Float    @default(0)
  isCustom       Boolean  @default(false)
  createdBy      String?
  createdAt      DateTime @default(now())

  ingredients  RecipeIngredient[]
  mealEntries  MealEntry[]
  plannedMeals PlannedMeal[]
  savedBy      SavedRecipe[]
  templateItems MealTemplateItem[]
}

model Ingredient {
  id    String @id @default(cuid())
  name  String @unique
  aisle String @default("Other")
  recipeIngredients RecipeIngredient[]
}

model RecipeIngredient {
  id           String @id @default(cuid())
  recipeId     String
  ingredientId String
  amount       Float  @default(1)
  unit         String @default("")
  original     String @default("")
  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
}

model SavedRecipe {
  id        String   @id @default(cuid())
  userId    String
  recipeId  String
  createdAt DateTime @default(now())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  @@unique([userId, recipeId])
}

model Meal {
  id        String   @id @default(cuid())
  userId    String
  date      String
  mealType  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries MealEntry[]
  @@index([userId, date])
}

model MealEntry {
  id         String  @id @default(cuid())
  mealId     String
  recipeId   String?
  customName String?
  servings   Float   @default(1)
  calories   Float   @default(0)
  protein    Float   @default(0)
  carbs      Float   @default(0)
  fat        Float   @default(0)
  fiber      Float   @default(0)
  sugar      Float   @default(0)
  loggedAt   DateTime @default(now())
  meal   Meal    @relation(fields: [mealId], references: [id], onDelete: Cascade)
  recipe Recipe? @relation(fields: [recipeId], references: [id], onDelete: SetNull)
}

model NutritionLog {
  id             String @id @default(cuid())
  userId         String
  date           String
  totalCalories  Float  @default(0)
  totalProtein   Float  @default(0)
  totalCarbs     Float  @default(0)
  totalFat       Float  @default(0)
  totalFiber     Float  @default(0)
  totalSugar     Float  @default(0)
  mealsLogged    Int    @default(0)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, date])
  @@index([userId, date])
}

model Goal {
  id             String @id @default(cuid())
  userId         String @unique
  calorieTarget  Float  @default(2000)
  proteinTarget  Float  @default(150)
  carbTarget     Float  @default(250)
  fatTarget      Float  @default(65)
  dietType       String @default("balanced")
  waterTargetMl  Int    @default(2500)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserPreference {
  id                  String @id @default(cuid())
  userId              String @unique
  cuisines            String @default("[]")
  allergies           String @default("[]")
  dislikedIngredients String @default("[]")
  maxPrepTime         Int    @default(60)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PlannedMeal {
  id        String   @id @default(cuid())
  userId    String
  date      String
  mealType  String
  recipeId  String
  servings  Float    @default(1)
  calories  Float    @default(0)
  protein   Float    @default(0)
  carbs     Float    @default(0)
  fat       Float    @default(0)
  createdAt DateTime @default(now())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  @@index([userId, date])
}

model GroceryList {
  id        String   @id @default(cuid())
  userId    String
  name      String   @default("My Grocery List")
  startDate String?
  endDate   String?
  createdAt DateTime @default(now())
  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items GroceryItem[]
}

model GroceryItem {
  id      String  @id @default(cuid())
  listId  String
  name    String
  amount  Float   @default(1)
  unit    String  @default("")
  aisle   String  @default("Other")
  checked Boolean @default(false)
  list GroceryList @relation(fields: [listId], references: [id], onDelete: Cascade)
}

model Insight {
  id          String   @id @default(cuid())
  userId      String
  type        String
  title       String
  description String
  severity    String   @default("info")
  data        String   @default("{}")
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}

model WaterLog {
  id        String   @id @default(cuid())
  userId    String
  date      String
  amountMl  Int      @default(0)
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, date])
  @@index([userId, date])
}

model MoodLog {
  id        String   @id @default(cuid())
  userId    String
  date      String
  mood      Int      @default(3)  // 1-5 scale
  energy    Int      @default(3)  // 1-5 scale
  note      String?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, date])
  @@index([userId, date])
}

model UserAchievement {
  id          String   @id @default(cuid())
  userId      String
  type        String   // e.g. "streak_7", "protein_king", "veggie_week"
  title       String
  description String
  icon        String
  unlockedAt  DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, type])
}

model MealTemplate {
  id        String   @id @default(cuid())
  userId    String
  name      String
  label     String   @default("custom")  // "gym_day", "office_day", etc.
  createdAt DateTime @default(now())
  user  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  items MealTemplateItem[]
}

model MealTemplateItem {
  id         String  @id @default(cuid())
  templateId String
  recipeId   String?
  customName String?
  mealType   String
  servings   Float   @default(1)
  calories   Float   @default(0)
  protein    Float   @default(0)
  carbs      Float   @default(0)
  fat        Float   @default(0)
  template MealTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  recipe   Recipe?      @relation(fields: [recipeId], references: [id], onDelete: SetNull)
}

model BloomScore {
  id          String   @id @default(cuid())
  userId      String
  weekStart   String   // ISO date of Monday
  score       Float    @default(0)  // 0-100
  adherence   Float    @default(0)
  consistency Float    @default(0)
  variety     Float    @default(0)
  hydration   Float    @default(0)
  createdAt   DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, weekStart])
}
